<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{3B2E6C2C-9E0B-4E7B-8B0B-2B9E6C2C9E0B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>InventorRayOptics</RootNamespace>
    <AssemblyName>InventorRayOptics</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>

    <!-- Inventor is 64-bit only; the add-in and WebView2Loader native binary must match. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Override this (e.g. via -p:InventorBinPath=...) if Inventor is installed elsewhere
         or at a different version. Defaults to the version found on the dev machine. -->
    <InventorBinPath Condition="'$(InventorBinPath)'==''">C:\Program Files\Autodesk\Inventor 2025\Bin\Public Assemblies</InventorBinPath>

    <WebView2PackageDir>$(MSBuildThisFileDirectory)..\packages\Microsoft.Web.WebView2.1.0.2792.45</WebView2PackageDir>

    <!-- Auto-generated per build (UTC) — no manual bumping to forget. Stamped into the
         .addin file's Description (what's on disk, ready to load next time — visible in
         Tools > Add-Ins even while an older build is still running) and compiled into
         BuildInfo.Version (what's actually loaded right now — shown in the ribbon
         tooltip and the panel itself). See StampAddinVersion/GenerateVersionFile below. -->
    <BuildVersion>$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd.HHmm'))</BuildVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />

    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorBinPath)\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>

    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(WebView2PackageDir)\lib\net462\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(WebView2PackageDir)\lib\net462\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="StandardAddInServer.cs" />
    <Compile Include="StepExporter.cs" />
    <Compile Include="OpticsDockable.cs" />
    <Compile Include="OpticsHostControl.cs" />
    <Compile Include="IconHelper.cs" />
    <Compile Include="JsonHelper.cs" />
    <Compile Include="MaterialLibrary.cs" />
    <Compile Include="SettingsStore.cs" />
    <Compile Include="PromptDialogs.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <!-- Generated fresh every build by GenerateVersionFile below, into the intermediate
         directory (not source-controlled) — doesn't exist yet at project-evaluation
         time, only needs to by the time CoreCompile actually reads it. -->
    <Compile Include="$(IntermediateOutputPath)GeneratedVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native WebView2 loader; must sit next to the add-in DLL. -->
    <None Include="$(WebView2PackageDir)\runtimes\win-x64\native\WebView2Loader.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WebView2Loader.dll</Link>
    </None>
    <!-- InventorRayOptics.addin is intentionally NOT listed here — it's a template
         (literal {{VERSION}} token) stamped into $(OutDir) by StampAddinVersion below,
         never copied verbatim. -->
    <None Include="Resources\icon16.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\icon32.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- The web app is loaded from a "webapp" folder next to the built DLL (see
       OpticsDockable.WebRoot). Keep the deployed copy in sync with source on every build. -->
  <Target Name="CopyWebApp" AfterTargets="Build">
    <ItemGroup>
      <WebAppFiles Include="$(MSBuildThisFileDirectory)..\..\webapp\**\*.*" Exclude="$(MSBuildThisFileDirectory)..\..\webapp\README.md" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAppFiles)" DestinationFolder="$(OutDir)webapp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Versioning (see the BuildVersion property above): a plain file-text-replace task,
       not a NuGet package — CodeTaskFactory ships with the .NET Framework MSBuild
       toolset itself, so this can't hit the "reference assembly doesn't exist at
       runtime" problem System.Web.Extensions did (see JsonHelper.cs) — it never ships
       with the add-in at all, it only runs at build time. -->
  <UsingTask TaskName="ReplaceTokenInFile" TaskFactory="CodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.v4.0.dll">
    <ParameterGroup>
      <SourcePath ParameterType="System.String" Required="true" />
      <DestinationPath ParameterType="System.String" Required="true" />
      <Token ParameterType="System.String" Required="true" />
      <Value ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = File.ReadAllText(SourcePath).Replace(Token, Value);
        Directory.CreateDirectory(Path.GetDirectoryName(DestinationPath));
        File.WriteAllText(DestinationPath, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Compiled into the DLL — reflects whatever build is actually LOADED right now
       (StandardAddInServer's ribbon tooltip and the panel header both show this).
       Also emits the real AssemblyVersion/AssemblyFileVersion (moved out of
       AssemblyInfo.cs) — those are the actual Win32 version resource fields Explorer's
       Properties > Details tab and PowerShell's Get-Item.VersionInfo read, so without
       this a hardcoded "1.0.0.0" there would never look current no matter what
       BuildInfo.Version or the .addin manifest say. -->
  <Target Name="GenerateVersionFile" BeforeTargets="CoreCompile">
    <ItemGroup>
      <VersionFileLines Include="using System.Reflection%3B" />
      <VersionFileLines Include="[assembly: AssemblyVersion(&quot;$(BuildVersion)&quot;)]" />
      <VersionFileLines Include="[assembly: AssemblyFileVersion(&quot;$(BuildVersion)&quot;)]" />
      <VersionFileLines Include="namespace InventorRayOptics { internal static class BuildInfo { public const string Version = &quot;$(BuildVersion)&quot;%3B } }" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)GeneratedVersion.cs" Lines="@(VersionFileLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Stamped into $(OutDir), never the checked-in template — reflects whatever build
       is on disk, ready to load next time (visible in Tools > Add-Ins independent of
       whether the currently-running DLL is older, e.g. because Inventor had it locked
       during a redeploy). -->
  <Target Name="StampAddinVersion" AfterTargets="Build">
    <ReplaceTokenInFile
      SourcePath="$(MSBuildThisFileDirectory)InventorRayOptics.addin"
      DestinationPath="$(OutDir)InventorRayOptics.addin"
      Token="{{VERSION}}"
      Value="$(BuildVersion)" />
  </Target>
</Project>
