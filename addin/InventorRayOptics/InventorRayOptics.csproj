<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{3B2E6C2C-9E0B-4E7B-8B0B-2B9E6C2C9E0B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>InventorRayOptics</RootNamespace>
    <AssemblyName>InventorRayOptics</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>

    <!-- Inventor is 64-bit only; the add-in and WebView2Loader native binary must match. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Override this (e.g. via -p:InventorBinPath=...) if Inventor is installed elsewhere
         or at a different version. Defaults to the version found on the dev machine. -->
    <InventorBinPath Condition="'$(InventorBinPath)'==''">C:\Program Files\Autodesk\Inventor 2025\Bin\Public Assemblies</InventorBinPath>

    <WebView2PackageDir>$(MSBuildThisFileDirectory)..\packages\Microsoft.Web.WebView2.1.0.2792.45</WebView2PackageDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />

    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorBinPath)\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>

    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(WebView2PackageDir)\lib\net462\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(WebView2PackageDir)\lib\net462\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="StandardAddInServer.cs" />
    <Compile Include="StepExporter.cs" />
    <Compile Include="OpticsDockable.cs" />
    <Compile Include="OpticsHostControl.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native WebView2 loader; must sit next to the add-in DLL. -->
    <None Include="$(WebView2PackageDir)\runtimes\win-x64\native\WebView2Loader.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WebView2Loader.dll</Link>
    </None>
    <None Include="InventorRayOptics.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- The web app is loaded from a "webapp" folder next to the built DLL (see
       OpticsDockable.WebRoot). Keep the deployed copy in sync with source on every build. -->
  <Target Name="CopyWebApp" AfterTargets="Build">
    <ItemGroup>
      <WebAppFiles Include="$(MSBuildThisFileDirectory)..\..\webapp\**\*.*" Exclude="$(MSBuildThisFileDirectory)..\..\webapp\README.md" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAppFiles)" DestinationFolder="$(OutDir)webapp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
